<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/SogouTextEyebrow"
        android:text="@string/migration_eyebrow" />

    <TextView
        style="@style/SogouTextPageTitle"
        android:text="@string/migration_title" />

    <TextView
        style="@style/SogouTextSubtitle"
        android:text="@string/migration_subtitle" />

    <TextView
        android:id="@+id/endpoint_summary"
        style="@style/SogouTextMeta"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_meta_pill"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp"
        android:text="@string/migration_route_unknown"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:id="@+id/step_rail"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_meta_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/step_read"
            style="@style/SogouTextStep"
            android:text="@string/step_read" />

        <TextView
            android:id="@+id/step_confirm"
            style="@style/SogouTextStep"
            android:layout_marginStart="4dp"
            android:text="@string/step_confirm" />

        <TextView
            android:id="@+id/step_commit"
            style="@style/SogouTextStep"
            android:layout_marginStart="4dp"
            android:text="@string/step_commit" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/status_band"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_row"
        android:gravity="top"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/status_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="1dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_status_waiting" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/status_idle_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/status_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/status_idle_detail"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/capture_source"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_primary_button"
        android:clickable="true"
        android:gravity="center"
        android:focusable="true"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:stateListAnimator="@null">

        <ImageView
            android:id="@+id/primary_action_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_download"
            android:tint="@color/on_primary" />

        <TextView
            android:id="@+id/primary_action_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/capture_source"
            android:textColor="@color/on_primary"
            android:textSize="15sp" />
    </LinearLayout>

    <Button
        android:id="@+id/open_settings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_secondary_button"
        android:drawableStart="@drawable/ic_settings"
        android:drawablePadding="8dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/open_settings"
        android:textAllCaps="false"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/wake_input"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0.01"
        android:background="@null"
        android:cursorVisible="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:importantForAccessibility="no"
        android:inputType="text"
        android:maxLines="1" />
</LinearLayout>
